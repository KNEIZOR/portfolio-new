{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "app.ts": {
      "includeFiles": "frontend/dist/**",
      "maxDuration": 60
    }
  }
}
