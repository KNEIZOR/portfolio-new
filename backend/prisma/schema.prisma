generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  ru
  hy
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  category    String
  year        Int
  role        String
  client      String?
  liveUrl     String?
  githubUrl   String?
  coverImage  String?
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  translations ProjectTranslation[]
  images       ProjectImage[]
  technologies  ProjectTechnology[]
  features      ProjectFeature[]

  @@index([status, updatedAt])
}

model ProjectTranslation {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locale            Locale
  title             String
  shortDescription  String
  fullDescription   String   @db.Text
  challenge         String   @db.Text
  solution          String   @db.Text
  technicalApproach String   @db.Text
  seoTitle          String   @default("")
  seoDescription    String   @default("") @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, locale])
  @@index([locale])
}

model ProjectImage {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl      String
  order         Int      @default(0)
  altTranslations ProjectImageTranslation[]

  @@index([projectId, order])
}

model ProjectImageTranslation {
  id              String       @id @default(cuid())
  projectImageId  String
  projectImage    ProjectImage @relation(fields: [projectImageId], references: [id], onDelete: Cascade)
  locale          Locale
  alt             String       @default("")

  @@unique([projectImageId, locale])
}

model Technology {
  id       String              @id @default(cuid())
  name     String              @unique
  projects ProjectTechnology[]
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
}

model ProjectFeature {
  id           String                      @id @default(cuid())
  projectId    String
  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order        Int                         @default(0)
  translations ProjectFeatureTranslation[]

  @@index([projectId, order])
}

model ProjectFeatureTranslation {
  id        String         @id @default(cuid())
  featureId String
  feature   ProjectFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  locale    Locale
  text      String

  @@unique([featureId, locale])
}
